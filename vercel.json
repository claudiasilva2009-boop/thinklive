{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.cjs": {
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.cjs"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.cjs"
    },
    {
      "source": "/((?!api/|uploads/|assets/|src/assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
