# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TMDB_API_KEY: Optional API key for The Movie Database (TMDB v3) for Filmes & Séries.
# When omitted, Thinklive automatically uses public IMDb / TVMaze / Wikidata endpoints.
TMDB_API_KEY=""

# GOOGLE_BOOKS_API_KEY: Optional API key for Google Books API for Livros.
# When omitted or rate-limited, Thinklive automatically uses Open Library.
GOOGLE_BOOKS_API_KEY=""

# SESSION_SECRET: Strong random string used to sign session cookies in production (Vercel).
SESSION_SECRET=""

# DEVELOPER_PASSCODE & DEVELOPER_EMAIL: Optional exclusive developer admin credentials.
# When omitted, the first-run claim form inside #dev-adm securely hashes and saves your passcode.
DEVELOPER_PASSCODE=""
DEVELOPER_EMAIL=""

# SUPABASE_URL & SUPABASE_SERVICE_ROLE_KEY: Optional persistent database on Vercel.
# Keep these strictly on the server (never prefix with VITE_).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
